{{ header }}
{% for idx, case in cases %}
@test '{{ case["descriptions"] | join(":") }}' {
    {% if idx == 0 %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip

    run jq -c -f {{ solution }} << 'END_INPUT'
{%- if "instructions" in case["input"] %}
{{
    {
        "robot": case["input"] | filter_keys("position", "direction"),
        "instructions": case["input"]["instructions"]
    } | tojson(separators=None, indent=2) | indent(6, first=True)
}}
{%- else %}
{{
    {
        "robot": case["input"] | filter_keys("position", "direction"),
    } | tojson(separators=None, indent=2) | indent(6, first=True)
}}
{%- endif %}
END_INPUT

    assert_success
    expected={{ case["expected"] | tojson | quote }}
    assert_objects_equal "$output" "$expected"
}
{% endfor %}
