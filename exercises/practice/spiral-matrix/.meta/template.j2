{{ header }}
{% for idx, case in cases %}
@test '{{ case["description"] }}' {
    {% if idx == 0 %}# {% endif %}[[ $BATS_RUN_SKIPPED == "true" ]] || skip

    run jq -c -f {{ solution }} << 'END_INPUT'
{{ case["input"] | tojson(separators=None, indent=2) | indent(8, first=True) }}
END_INPUT
    expected=$(jq -c . <<'END_EXPECTED'
        [
{%- if case["expected"] %}
{{ case["expected"] | map("tojson", separators=None) | join(",\n") | indent(12, first=True) }}
{%- endif %}
        ]
END_EXPECTED
)

    assert_success
    assert_objects_equal "$output" "$expected"
}
{% endfor %}
